{
  "name": "syntax-drills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adaptive, keyboard-first syntax drills. Python first.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "validate-content": "tsx scripts/validate-content.ts",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run test && npm run boundaries && npm run validate-content"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "pyodide": "^314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^6.0.0",
    "ulid": "^3.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "dependency-cruiser": "^18.7.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
